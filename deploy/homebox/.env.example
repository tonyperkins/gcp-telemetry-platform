# Copy to .env and fill in. Do NOT commit the real .env.

# Full URL of the Cloud Run push endpoint (note the path).
PUSH_URL=https://telemetry-api-XXXXXXXX-ey.a.run.app/ingest/flight/push

# Shared bearer token. Must match the INGEST_PUSH_TOKEN secret in GCP Secret Manager.
# Generate one with: openssl rand -hex 32
INGEST_PUSH_TOKEN=

# OpenSky OAuth2 credentials (same account used by the platform).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Bounding box: lamin,lomin,lamax,lomax (default = Austin, TX).
OPENSKY_BBOX=29.8,-98.2,30.8,-97.2

# Seconds between pushes.
POLL_INTERVAL_SECONDS=60

# Set to "true" to fetch+push exactly once and exit (useful for host cron).
RUN_ONCE=false
